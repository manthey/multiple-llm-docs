{
	"name": "obsidian-multiple-llm-docs",
	"version": "1.4.0",
	"description": "Chat with LLM (ChatGPT) inside Obsidian files",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"format": "prettier -w styles.css manifest.json package.json src/*.ts src/settings-tab/*.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"test": "jest --coverage"
	},
	"keywords": [
		"Obsidian",
		"LLM",
		"OpenAI",
		"Ollama"
	],
	"author": "Shane Lamb",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1"
	},
	"devDependencies": {
		"@codemirror/language": "^6.10.8",
		"@types/node": "^25.0.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"builtin-modules": "^5.0.0",
		"esbuild": "^0.27.0",
		"jest": "^30.0.0",
		"obsidian": "latest",
		"prettier": "^3.5.3",
		"ts-jest": "^29.2.5",
		"tslib": "^2.4.0",
		"typescript": "^5.0.0"
	},
	"overrides": {
		"glob": "^13.0.0",
		"test-exclude": "^8.0.0"
	},
	"allowScripts": {
		"unrs-resolver@1.12.2": true,
		"esbuild@0.27.7": true,
		"@parcel/watcher@2.6.0": true
	}
}
